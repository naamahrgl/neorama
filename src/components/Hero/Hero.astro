---
/**
 * * Hero with background image
 * You'll want a mobile image, and a desktop image for this.
 */

import Button from "@components/Button/Button.astro";
import heroImage from "@images/MAIN TOP IMAGE.webp";
import heroImageMobile from "@images/MAIN TOP IMAGE.webp";

import { Image } from "astro:assets";

---

<section id="hero" class="relative z-10 flex min-h-[100lvh] w-full">
	<!-- background image -->
	<div class="absolute -z-10 h-full min-h-full w-full overflow-hidden">
		<div class="absolute inset-0 bg-black/10"></div>

		<Image
			src={heroImage}
			class="hidden h-auto min-h-full w-full object-cover object-bottom sm:block"
			alt="wedding"
			aria-hidden="true"
			loading="eager"
			height={1400}
		/>
		<Image
			src={heroImageMobile}
			class="h-auto min-h-full w-full object-cover sm:hidden"
			alt="wedding"
			aria-hidden="true"
loading="eager" 
    fetchpriority="high"
				width={1200}
		/>
	</div>

	<!-- hero items -->
	<div class="site-container relative w-full gap-10 py-44 text-center md:py-52 md:text-left">
		<!-- Hero text -->
		<div class="text-base-50 my-auto mr-auto max-w-[1180px] flex-col">

<p class="font-['Tenor_Sans'] mt-0 text-3xl tracking-wider drop-shadow-[0_1px_1px_rgba(0,0,0,0.2)] md:max-w-[1180px] md:text-6xl font-bold">
    THE WAY LIFE SHOULD BE LIVED
</p>
			<div class="mt-8 flex flex-wrap justify-center gap-4 md:justify-start">
				<Button
					variant="ghost"
					arrow="right"
					href="/#contact"
					class="pl-0 text-xl text-white drop-shadow-[0_1px_1px_rgba(0,0,0,0.2)] md:text-3xl"
					        onclick="if(window.gtag) { window.gtag('event', 'click_contact_button', { 'location': 'hero_section' }); }"
				>
					APPLY NOW 
				</Button>
			</div>
		</div>
	</div>
</section>
